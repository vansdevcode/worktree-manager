{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016CDQpHespUwHqEtcd8fATx","type":"tool_result","content":"     1→package proxy\n     2→\n     3→import (\n     4→\t\"encoding/json\"\n     5→\t\"fmt\"\n     6→\n     7→\t\"github.com/caddyserver/caddy/v2\"\n     8→\t_ \"github.com/caddyserver/caddy/v2/modules/standard\"\n     9→\n    10→\t\"github.com/vansdevcode/worktree-manager/internal/routing\"\n    11→)\n    12→\n    13→// Server wraps an embedded Caddy instance for TLS-terminating reverse proxying.\n    14→type Server struct {\n    15→\thttpPort  int\n    16→\thttpsPort int\n    17→}\n    18→\n    19→// New creates a proxy server that will listen on the given ports.\n    20→func New(httpPort, httpsPort int) *Server {\n    21→\treturn &Server{\n    22→\t\thttpPort:  httpPort,\n    23→\t\thttpsPort: httpsPort,\n    24→\t}\n    25→}\n    26→\n    27→// Start loads the Caddy config built from the routing table.\n    28→func (s *Server) Start(table *routing.Table) error {\n    29→\treturn s.load(table)\n    30→}\n    31→\n    32→// Reload rebuilds and hot-reloads the Caddy config from the current routing table.\n    33→func (s *Server) Reload(table *routing.Table) error {\n    34→\treturn s.load(table)\n    35→}\n    36→\n    37→// Stop gracefully stops the Caddy instance.\n    38→func (s *Server) Stop() error {\n    39→\treturn caddy.Stop()\n    40→}\n    41→\n    42→func (s *Server) load(table *routing.Table) error {\n    43→\tcfg := s.buildConfig(table)\n    44→\n    45→\tdata, err := json.Marshal(cfg)\n    46→\tif err != nil {\n    47→\t\treturn fmt.Errorf(\"marshaling caddy config: %w\", err)\n    48→\t}\n    49→\n    50→\tif err := caddy.Load(data, true); err != nil {\n    51→\t\treturn fmt.Errorf(\"loading caddy config: %w\", err)\n    52→\t}\n    53→\n    54→\treturn nil\n    55→}\n    56→\n    57→// buildConfig creates a Caddy JSON config from the routing table.\n    58→func (s *Server) buildConfig(table *routing.Table) map[string]any {\n    59→\troutes := make([]map[string]any, 0, len(table.Sites))\n    60→\tfor domain, site := range table.Sites {\n    61→\t\troute := map[string]any{\n    62→\t\t\t\"match\": []map[string]any{\n    63→\t\t\t\t{\"host\": []string{domain}},\n    64→\t\t\t},\n    65→\t\t\t\"handle\": []map[string]any{\n    66→\t\t\t\t{\n    67→\t\t\t\t\t\"handler\": \"reverse_proxy\",\n    68→\t\t\t\t\t\"upstreams\": []map[string]any{\n    69→\t\t\t\t\t\t{\"dial\": site.Upstream},\n    70→\t\t\t\t\t},\n    71→\t\t\t\t},\n    72→\t\t\t},\n    73→\t\t}\n    74→\t\troutes = append(routes, route)\n    75→\t}\n    76→\n    77→\tcfg := map[string]any{\n    78→\t\t\"apps\": map[string]any{\n    79→\t\t\t\"http\": map[string]any{\n    80→\t\t\t\t\"http_port\":  s.httpPort,\n    81→\t\t\t\t\"https_port\": s.httpsPort,\n    82→\t\t\t\t\"servers\": map[string]any{\n    83→\t\t\t\t\t\"srv0\": map[string]any{\n    84→\t\t\t\t\t\t\"listen\": []string{fmt.Sprintf(\":%d\", s.httpsPort)},\n    85→\t\t\t\t\t\t\"routes\": routes,\n    86→\t\t\t\t\t\t\"tls_connection_policies\": []map[string]any{{}},\n    87→\t\t\t\t\t},\n    88→\t\t\t\t},\n    89→\t\t\t},\n    90→\t\t\t\"tls\": map[string]any{\n    91→\t\t\t\t\"automation\": map[string]any{\n    92→\t\t\t\t\t\"policies\": []map[string]any{\n    93→\t\t\t\t\t\t{\n    94→\t\t\t\t\t\t\t\"issuers\": []map[string]any{\n    95→\t\t\t\t\t\t\t\t{\"module\": \"internal\"},\n    96→\t\t\t\t\t\t\t},\n    97→\t\t\t\t\t\t},\n    98→\t\t\t\t\t},\n    99→\t\t\t\t},\n   100→\t\t\t},\n   101→\t\t},\n   102→\t}\n   103→\n   104→\treturn cfg\n   105→}\n   106→"}]},"parent_tool_use_id":null,"session_id":"18429563-3809-48d8-9f5c-3e3092ffda7a","uuid":"d068a4fb-958a-480c-8a50-be9608962ec6","tool_use_result":{"type":"text","file":{"filePath":"/Users/vanderlei/vans/wtm/internal/proxy/proxy.go","content":"package proxy\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\n\t\"github.com/caddyserver/caddy/v2\"\n\t_ \"github.com/caddyserver/caddy/v2/modules/standard\"\n\n\t\"github.com/vansdevcode/worktree-manager/internal/routing\"\n)\n\n// Server wraps an embedded Caddy instance for TLS-terminating reverse proxying.\ntype Server struct {\n\thttpPort  int\n\thttpsPort int\n}\n\n// New creates a proxy server that will listen on the given ports.\nfunc New(httpPort, httpsPort int) *Server {\n\treturn &Server{\n\t\thttpPort:  httpPort,\n\t\thttpsPort: httpsPort,\n\t}\n}\n\n// Start loads the Caddy config built from the routing table.\nfunc (s *Server) Start(table *routing.Table) error {\n\treturn s.load(table)\n}\n\n// Reload rebuilds and hot-reloads the Caddy config from the current routing table.\nfunc (s *Server) Reload(table *routing.Table) error {\n\treturn s.load(table)\n}\n\n// Stop gracefully stops the Caddy instance.\nfunc (s *Server) Stop() error {\n\treturn caddy.Stop()\n}\n\nfunc (s *Server) load(table *routing.Table) error {\n\tcfg := s.buildConfig(table)\n\n\tdata, err := json.Marshal(cfg)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"marshaling caddy config: %w\", err)\n\t}\n\n\tif err := caddy.Load(data, true); err != nil {\n\t\treturn fmt.Errorf(\"loading caddy config: %w\", err)\n\t}\n\n\treturn nil\n}\n\n// buildConfig creates a Caddy JSON config from the routing table.\nfunc (s *Server) buildConfig(table *routing.Table) map[string]any {\n\troutes := make([]map[string]any, 0, len(table.Sites))\n\tfor domain, site := range table.Sites {\n\t\troute := map[string]any{\n\t\t\t\"match\": []map[string]any{\n\t\t\t\t{\"host\": []string{domain}},\n\t\t\t},\n\t\t\t\"handle\": []map[string]any{\n\t\t\t\t{\n\t\t\t\t\t\"handler\": \"reverse_proxy\",\n\t\t\t\t\t\"upstreams\": []map[string]any{\n\t\t\t\t\t\t{\"dial\": site.Upstream},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t}\n\t\troutes = append(routes, route)\n\t}\n\n\tcfg := map[string]any{\n\t\t\"apps\": map[string]any{\n\t\t\t\"http\": map[string]any{\n\t\t\t\t\"http_port\":  s.httpPort,\n\t\t\t\t\"https_port\": s.httpsPort,\n\t\t\t\t\"servers\": map[string]any{\n\t\t\t\t\t\"srv0\": map[string]any{\n\t\t\t\t\t\t\"listen\": []string{fmt.Sprintf(\":%d\", s.httpsPort)},\n\t\t\t\t\t\t\"routes\": routes,\n\t\t\t\t\t\t\"tls_connection_policies\": []map[string]any{{}},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t\t\"tls\": map[string]any{\n\t\t\t\t\"automation\": map[string]any{\n\t\t\t\t\t\"policies\": []map[string]any{\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"issuers\": []map[string]any{\n\t\t\t\t\t\t\t\t{\"module\": \"internal\"},\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t},\n\t}\n\n\treturn cfg\n}\n","numLines":106,"startLine":1,"totalLines":106}}}
