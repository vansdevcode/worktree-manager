{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014UH39y2oiEUdvjHC5PCiuk","type":"tool_result","content":"     1→package daemon\n     2→\n     3→import (\n     4→\t\"fmt\"\n     5→\t\"os\"\n     6→\t\"os/signal\"\n     7→\t\"path/filepath\"\n     8→\t\"strconv\"\n     9→\t\"strings\"\n    10→\t\"syscall\"\n    11→\n    12→\t\"github.com/vansdevcode/worktree-manager/internal/dns\"\n    13→\t\"github.com/vansdevcode/worktree-manager/internal/proxy\"\n    14→\t\"github.com/vansdevcode/worktree-manager/internal/routing\"\n    15→)\n    16→\n    17→// Daemon manages the DNS server and reverse proxy lifecycle.\n    18→type Daemon struct {\n    19→\troutesPath string\n    20→\tpidPath    string\n    21→\tdnsAddr    string\n    22→\thttpPort   int\n    23→\thttpsPort  int\n    24→\tdnsServer  *dns.Server\n    25→\tproxyServer *proxy.Server\n    26→}\n    27→\n    28→// New creates a daemon with the given configuration.\n    29→func New(routesPath, pidPath, dnsAddr string, httpPort, httpsPort int) *Daemon {\n    30→\treturn &Daemon{\n    31→\t\troutesPath: routesPath,\n    32→\t\tpidPath:    pidPath,\n    33→\t\tdnsAddr:    dnsAddr,\n    34→\t\thttpPort:   httpPort,\n    35→\t\thttpsPort:  httpsPort,\n    36→\t}\n    37→}\n    38→\n    39→// Run starts the DNS server and proxy, writes the PID file, and blocks until\n    40→// SIGTERM or SIGINT is received. It cleans up on exit.\n    41→func (d *Daemon) Run() error {\n    42→\tif err := d.writePID(); err != nil {\n    43→\t\treturn err\n    44→\t}\n    45→\tdefer func() { _ = os.Remove(d.pidPath) }()\n    46→\n    47→\ttable, err := routing.Load(d.routesPath)\n    48→\tif err != nil {\n    49→\t\treturn fmt.Errorf(\"loading routes: %w\", err)\n    50→\t}\n    51→\n    52→\td.dnsServer = dns.New(d.dnsAddr)\n    53→\tif err := d.dnsServer.Start(); err != nil {\n    54→\t\treturn fmt.Errorf(\"starting dns: %w\", err)\n    55→\t}\n    56→\tdefer func() { _ = d.dnsServer.Stop() }()\n    57→\n    58→\td.pro