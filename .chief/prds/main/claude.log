, 0, 0)\n\tif err := d.writePID(); err != nil {\n\t\tt.Fatalf(\"writePID: %v\", err)\n\t}\n\tdata, err := os.ReadFile(pidPath)\n\tif err != nil {\n\t\tt.Fatalf(\"reading PID file: %v\", err)\n\t}\n\tpid, err := strconv.Atoi(string(data))\n\tif err != nil {\n\t\tt.Fatalf(\"parsing PID: %v\", err)\n\t}\n\tif pid != os.Getpid() {\n\t\tt.Errorf(\"expected PID %d, got %d\", os.Getpid(), pid)\n\t}\n}\n","structuredPatch":[{"oldStart":47,"oldLines":7,"newStart":47,"newLines":7,"lines":[" func TestWritePID(t *testing.T) {","   dir := t.TempDir()","   pidPath := filepath.Join(dir, \"sub\", \"test.pid\")","-  d := New(\"/dev/null\", pidPath, \"127.0.0.1:0\", 0, 0)","+  d := New(\"/dev/null\", pidPath, \"\", \"127.0.0.1:0\", 0, 0)","   if err := d.writePID(); err != nil {","     t.Fatalf(\"writePID: %v\", err)","   }"]}],"userModified":false,"replaceAll":false}}
