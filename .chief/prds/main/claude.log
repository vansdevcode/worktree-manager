{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NeMCQRPxB99NP7ipVq93dd","type":"tool_result","content":"     1→package routing\n     2→\n     3→import (\n     4→\t\"fmt\"\n     5→\t\"os\"\n     6→\t\"path/filepath\"\n     7→\t\"sort\"\n     8→\n     9→\t\"gopkg.in/yaml.v3\"\n    10→)\n    11→\n    12→// Site represents a registered route entry.\n    13→type Site struct {\n    14→\tDomain   string            `yaml:\"-\"`\n    15→\tUpstream string            `yaml:\"upstream\"`\n    16→\tMeta     map[string]string `yaml:\"meta,omitempty\"`\n    17→}\n    18→\n    19→// Table holds the routing state.\n    20→type Table struct {\n    21→\tSites map[string]*Site `yaml:\"sites\"`\n    22→}\n    23→\n    24→// NewTable creates an empty routing table.\n    25→func NewTable() *Table {\n    26→\treturn &Table{Sites: make(map[string]*Site)}\n    27→}\n    28→\n    29→// Register adds or updates a route in the table.\n    30→func (t *Table) Register(domain, upstream string, meta map[string]string) {\n    31→\tt.Sites[domain] = &Site{\n    32→\t\tDomain:   domain,\n    33→\t\tUpstream: upstream,\n    34→\t\tMeta:     meta,\n    35→\t}\n    36→}\n    37→\n    38→// Unregister removes a route from the table. Returns an error if the domain doesn't exist.\n    39→func (t *Table) Unregister(domain string) error {\n    40→\tif _, ok := t.Sites[domain]; !ok {\n    41→\t\treturn fmt.Errorf(\"domain %q is not registered\", domain)\n    42→\t}\n    43→\tdelete(t.Sites, domain)\n    44→\treturn nil\n    45→}\n    46→\n    47→// Get returns a site by domain and whether it exists.\n    48→func (t *Table) Get(domain string) (*Site, bool) {\n    49→\ts, ok := t.Sites[domain]\n    50→\tif ok {\n    51→\t\ts.Domain = domain\n    52→\t}\n    53→\treturn s, ok\n    54→}\n    55→\n    56→// List returns all sites sorted alphabetically by domain.\n    57→func (t *Table) List() []Site {\n    58→\tresult := make([]Site, 0, len(t.Sites))\n    59→\tfor domain, site := range t.Sites {\n    60→\t\ts := *site\n    61→\t\ts.Domain = domain\n    62→\t\tresult = append(result, s)\n    63→\t}\n    64→\tsort.Slice(result, func(i, j int) bool {\n    65→\t\treturn result[i].Domain < result[j].Domain\n    66→\t})\n    67→\treturn result\n    68→}\n    69→\n    70→// Load reads and parses a routing table from a YAML file.\n    71→// Returns an empty table if the file doesn't exist.\n    72→func Load(path string) (*Table, error) {\n    73→\tdata, err := os.ReadFile(path)\n    74→\tif err != nil {\n    75→\t\tif os.IsNotExist(err) {\n    76→\t\t\treturn NewTable(), nil\n    77→\t\t}\n    78→\t\treturn nil, fmt.Errorf(\"reading routes file: %w\", err)\n    79→\t}\n    80→\n    81→\tt := NewTable()\n    82→\tif err := yaml.Unmarshal(data, t); err != nil {\n    83→\t\treturn nil, fmt.Errorf(\"parsing routes file: %w\", err)\n    84→\t}\n    85→\n    86→\tif t.Sites == nil {\n    87→\t\tt.Sites = make(map[string]*Site)\n    88→\t}\n    89→\n    90→\treturn t, nil\n    91→}\n    92→\n    93→// Save writes the routing table to a YAML file atomically (temp file + rename).\n    94→func Save(path string, table *Table) error {\n    95→\tdata, err := yaml.Marshal(table)\n    96→\tif err != nil {\n    97→\t\treturn fmt.Errorf(\"marshaling routes: %w\", err)\n    98→\t}\n    99→\n   100→\tdir := filepath.Dir(path)\n   101→\tif err := os.MkdirAll(dir, 0o755); err != nil {\n   102→\t\treturn fmt.Errorf(\"creating config directory: %w\", err)\n   103→\t}\n   104→\n   105→\ttmp, err := os.CreateTemp(dir, \".routes-*.yaml\")\n   106→\tif err != nil {\n   107→\t\treturn fmt.Errorf(\"creating temp file: %w\", err)\n   108→\t}\n   109→\ttmpPath := tmp.Name()\n   110→\n   111→\tif _, err := tmp.Write(data); err != nil {\n   112→\t\t_ = tmp.Close()\n   113→\t\t_ = os.Remove(tmpPath)\n   114→\t\treturn fmt.Errorf(\"writing temp file: %w\", err)\n   115→\t}\n   116→\n   117→\tif err := tmp.Close(); err != nil {\n   118→\t\t_ = os.Remove(tmpPath)\n   119→\t\treturn fmt.Errorf(\"closing temp file: %w\", err)\n   120→\t}\n   121→\n   122→\tif err := os.Rename(tmpPath, path); err != nil {\n   123→\t\t_ = os.Remove(tmpPath)\n   124→\t\treturn fmt.Errorf(\"renaming temp file: %w\", err)\n   125→\t}\n   126→\n   127→\treturn nil\n   128→}\n   129→"}]},"parent_tool_use_id":null,"session_id":"b3e2ec84-c6d0-495a-acfd-c629e33a07ba","uuid":"b4dfcf54-cc2b-43f2-b776-d4d4984dfd63","tool_use_result":{"type":"text","file":{"filePath":"/Users/vanderlei/vans/wtm/internal/routing/routing.go","content":"package routing\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// Site represents a registered route entry.\ntype Site struct {\n\tDomain   string            `yaml:\"-\"`\n\tUpstream string            `yaml:\"upstream\"`\n\tMeta     map[string]string `yaml:\"meta,omitempty\"`\n}\n\n// Table holds the routing state.\ntype Table struct {\n\tSites map[string]*Site `yaml:\"sites\"`\n}\n\n// NewTable creates an empty routing table.\nfunc NewTable() *Table {\n\treturn &Table{Sites: make(map[string]*Site)}\n}\n\n// Register adds or updates a route in the table.\nfunc (t *Table) Register(domain, upstream string, meta map[string]string) {\n\tt.Sites[domain] = &Site{\n\t\tDomain:   domain,\n\t\tUpstream: upstream,\n\t\tMeta:     meta,\n\t}\n}\n\n// Unregister removes a route from the table. Returns an error if the domain doesn't exist.\nfunc (t *Table) Unregister(domain string) error {\n\tif _, ok := t.Sites[domain]; !ok {\n\t\treturn fmt.Errorf(\"domain %q is not registered\", domain)\n\t}\n\tdelete(t.Sites, domain)\n\treturn nil\n}\n\n// Get returns a site by domain and whether it exists.\nfunc (t *Table) Get(domain string) (*Site, bool) {\n\ts, ok := t.Sites[domain]\n\tif ok {\n\t\ts.Domain = domain\n\t}\n\treturn s, ok\n}\n\n// List returns all sites sorted alphabetically by domain.\nfunc (t *Table) List() []Site {\n\tresult := make([]Site, 0, len(t.Sites))\n\tfor domain, site := range t.Sites {\n\t\ts := *site\n\t\ts.Domain = domain\n\t\tresult = append(result, s)\n\t}\n\tsort.Slice(result, func(i, j int) bool {\n\t\treturn result[i].Domain < result[j].Domain\n\t})\n\treturn result\n}\n\n// Load reads and parses a routing table from a YAML file.\n// Returns an empty table if the file doesn't exist.\nfunc Load(path string) (*Table, error) {\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn NewTable(), nil\n\t\t}\n\t\treturn nil, fmt.Errorf(\"reading routes file: %w\", err)\n\t}\n\n\tt := NewTable()\n\tif err := yaml.Unmarshal(data, t); err != nil {\n\t\treturn nil, fmt.Errorf(\"parsing routes file: %w\", err)\n\t}\n\n\tif t.Sites == nil {\n\t\tt.Sites = make(map[string]*Site)\n\t}\n\n\treturn t, nil\n}\n\n// Save writes the routing table to a YAML file atomically (temp file + rename).\nfunc Save(path string, table *Table) error {\n\tdata, err := yaml.Marshal(table)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"marshaling routes: %w\", err)\n\t}\n\n\tdir := filepath.Dir(path)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn fmt.Errorf(\"creating config directory: %w\", err)\n\t}\n\n\ttmp, err := os.CreateTemp(dir, \".routes-*.yaml\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"creating temp file: %w\", err)\n\t}\n\ttmpPath := tmp.Name()\n\n\tif _, err := tmp.Write(data); err != nil {\n\t\t_ = tmp.Close()\n\t\t_ = os.Remove(tmpPath)\n\t\treturn fmt.Errorf(\"writing temp file: %w\", err)\n\t}\n\n\tif err := tmp.Close(); err != nil {\n\t\t_ = os.Remove(tmpPath)\n\t\treturn fmt.Errorf(\"closing temp file: %w\", err)\n\t}\n\n\tif err := os.Rename(tmpPath, path); err != nil {\n\t\t_ = os.Remove(tmpPath)\n\t\treturn fmt.Errorf(\"renaming temp file: %w\", err)\n\t}\n\n\treturn nil\n}\n","numLines":129,"startLine":1,"totalLines":129}}}
