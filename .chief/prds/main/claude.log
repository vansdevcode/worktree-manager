{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01URGnXNpXHNuuhHU2Utx5ic","type":"tool_result","content":"     1→package daemon\n     2→\n     3→import (\n     4→\t\"bufio\"\n     5→\t\"fmt\"\n     6→\t\"log\"\n     7→\t\"net\"\n     8→\t\"os\"\n     9→\t\"os/signal\"\n    10→\t\"path/filepath\"\n    11→\t\"strconv\"\n    12→\t\"strings\"\n    13→\t\"syscall\"\n    14→\n    15→\t\"github.com/vansdevcode/worktree-manager/internal/dns\"\n    16→\t\"github.com/vansdevcode/worktree-manager/internal/proxy\"\n    17→\t\"github.com/vansdevcode/worktree-manager/internal/routing\"\n    18→)\n    19→\n    20→// Daemon manages the DNS server and reverse proxy lifecycle.\n    21→type Daemon struct {\n    22→\troutesPath  string\n    23→\tpidPath     string\n    24→\tsocketPath  string\n    25→\tdnsAddr     string\n    26→\thttpPort    int\n    27→\thttpsPort   int\n    28→\tdnsServer   *dns.Server\n    29→\tproxyServer *proxy.Server\n    30→}\n    31→\n    32→// New creates a daemon with the given configuration.\n    33→func New(routesPath, pidPath, socketPath, dnsAddr string, httpPort, httpsPort int) *Daemon {\n    34→\treturn &Daemon{\n    35→\t\troutesPath: routesPath,\n    36→\t\tpidPath:    pidPath,\n    37→\t\tsocketPath: socketPath,\n    38→\t\tdnsAddr:    dnsAddr,\n    39→\t\thttpPort:   httpPort,\n    40→\t\thttpsPort:  httpsPort,\n    41→\t}\n    42→}\n    43→\n    44→// Run starts the DNS server and proxy, writes the PID file, and blocks until\n    45→// SIGTERM or SIGINT is received. It cleans up on exit.\n    46→func (d *Daemon) Run() error {\n    47→\tif err := d.writePID(); err != nil {\n    48→\t\treturn err\n    49→\t}\n    50→\tdefer func() { _ = os.Remove(d.pidPath) }()\n    51→\n    52→\ttable, err := routing.Load(d.routesPath)\n    53→\tif err != nil {\n    54→\t\treturn fmt.Errorf(\"loading routes: %w\", err)\n    55→\t}\n    56→\n    57→\td.dnsServer = dns.New(d.dnsAddr)\n    58→\tif err := d.dnsServer.Start(); err != nil {\n    5