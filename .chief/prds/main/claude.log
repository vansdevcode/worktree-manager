{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U9MpPd7WnrbXp7A7uPRP51","type":"tool_result","content":"     1→package main\n     2→\n     3→import (\n     4→\t\"fmt\"\n     5→\t\"net\"\n     6→\t\"strings\"\n     7→\n     8→\t\"github.com/spf13/cobra\"\n     9→\t\"github.com/vansdevcode/worktree-manager/internal/routing\"\n    10→)\n    11→\n    12→var registerPort int\n    13→var registerMeta []string\n    14→\n    15→var registerCmd = &cobra.Command{\n    16→\tUse:   \"register <domain>\",\n    17→\tShort: \"Register a domain-to-port mapping\",\n    18→\tLong: `Register a local service by mapping a domain to a port.\n    19→\n    20→Examples:\n    21→  devtree register myapp.test --port 8080\n    22→  devtree register myapp.test --port 8080 --meta stack=go:1.23 --meta env=dev`,\n    23→\tArgs: cobra.ExactArgs(1),\n    24→\tRunE: runRegister,\n    25→}\n    26→\n    27→func init() {\n    28→\tregisterCmd.Flags().IntVar(&registerPort, \"port\", 0, \"Port number for the upstream service (required)\")\n    29→\t_ = registerCmd.MarkFlagRequired(\"port\")\n    30→\tregisterCmd.Flags().StringArrayVar(&registerMeta, \"meta\", nil, \"Metadata key=value pairs (can be repeated)\")\n    31→}\n    32→\n    33→func runRegister(_ *cobra.Command, args []string) error {\n    34→\tdomain := args[0]\n    35→\tupstream := fmt.Sprintf(\"localhost:%d\", registerPort)\n    36→\n    37→\tmeta := parseMeta(registerMeta)\n    38→\n    39→\troutesPath := DefaultRoutesPath()\n    40→\ttable, err := routing.Load(routesPath)\n    41→\tif err != nil {\n    42→\t\treturn fmt.Errorf(\"loading routes: %w\", err)\n    43→\t}\n    44→\n    45→\ttable.Register(domain, upstream, meta)\n    46→\n    47→\tif err := routing.Save(routesPath, table); err != nil {\n    48→\t\treturn fmt.Errorf(\"saving routes: %w\", err)\n    49→\t}\n    50→\n    51→\tfmt.Printf(\"Registered %s -> %s\\n\", domain, upstream)\n    52→\n    53→\tsendReload()\n    54→\n    55→\treturn nil\n    56→}\n    57→\n    58→func parseMeta(pairs []string) map[string]string {\n    59→\tif len(pairs) == 0 {\n    60→\t\treturn nil\n    61→\t}\n    62→\tmeta := make(map[string]string, len(pairs))\n    63→\tfor _, pair := range pairs {\n    64→\t\tk, v, _ := strings.Cut(pair, \"=\")\n    65→\t\tmeta[k] = v\n    66→\t}\n    67→\treturn meta\n    68→}\n    69→\n    70→func sendReload() {\n    71→\tsockPath := DefaultSocketPath()\n    72→\tconn, err := net.Dial(\"unix\", sockPath)\n    73→\tif err != nil {\n    74→\t\treturn\n    75→\t}\n    76→\tdefer func() { _ = conn.Close() }()\n    77→\t_, _ = conn.Write([]byte(\"reload\\n\"))\n    78→}\n    79→"}]},"parent_tool_use_id":null,"session_id":"a83ce7ec-5810-4ad9-b577-278d5f65bb62","uuid":"9d630d47-09e9-46c7-bbd8-da234664807d","tool_use_result":{"type":"text","file":{"filePath":"/Users/vanderlei/vans/wtm/cmd/devtree/register.go","content":"package main\n\nimport (\n\t\"fmt\"\n\t\"net\"\n\t\"strings\"\n\n\t\"github.com/spf13/cobra\"\n\t\"github.com/vansdevcode/worktree-manager/internal/routing\"\n)\n\nvar registerPort int\nvar registerMeta []string\n\nvar registerCmd = &cobra.Command{\n\tUse:   \"register <domain>\",\n\tShort: \"Register a domain-to-port mapping\",\n\tLong: `Register a local service by mapping a domain to a port.\n\nExamples:\n  devtree register myapp.test --port 8080\n  devtree register myapp.test --port 8080 --meta stack=go:1.23 --meta env=dev`,\n\tArgs: cobra.ExactArgs(1),\n\tRunE: runRegister,\n}\n\nfunc init() {\n\tregisterCmd.Flags().IntVar(&registerPort, \"port\", 0, \"Port number for the upstream service (required)\")\n\t_ = registerCmd.MarkFlagRequired(\"port\")\n\tregisterCmd.Flags().StringArrayVar(&registerMeta, \"meta\", nil, \"Metadata key=value pairs (can be repeated)\")\n}\n\nfunc runRegister(_ *cobra.Command, args []string) error {\n\tdomain := args[0]\n\tupstream := fmt.Sprintf(\"localhost:%d\", registerPort)\n\n\tmeta := parseMeta(registerMeta)\n\n\troutesPath := DefaultRoutesPath()\n\ttable, err := routing.Load(routesPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"loading routes: %w\", err)\n\t}\n\n\ttable.Register(domain, upstream, meta)\n\n\tif err := routing.Save(routesPath, table); err != nil {\n\t\treturn fmt.Errorf(\"saving routes: %w\", err)\n\t}\n\n\tfmt.Printf(\"Registered %s -> %s\\n\", domain, upstream)\n\n\tsendReload()\n\n\treturn nil\n}\n\nfunc parseMeta(pairs []string) map[string]string {\n\tif len(pairs) == 0 {\n\t\treturn nil\n\t}\n\tmeta := make(map[string]string, len(pairs))\n\tfor _, pair := range pairs {\n\t\tk, v, _ := strings.Cut(pair, \"=\")\n\t\tmeta[k] = v\n\t}\n\treturn meta\n}\n\nfunc sendReload() {\n\tsockPath := DefaultSocketPath()\n\tconn, err := net.Dial(\"unix\", sockPath)\n\tif err != nil {\n\t\treturn\n\t}\n\tdefer func() { _ = conn.Close() }()\n\t_, _ = conn.Write([]byte(\"reload\\n\"))\n}\n","numLines":79,"startLine":1,"totalLines":79}}}
