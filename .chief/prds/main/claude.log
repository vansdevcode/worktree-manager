[k] = v\n\t}\n\treturn meta\n}\n\nfunc sendReload() {\n\tsockPath := DefaultSocketPath()\n\tconn, err := net.Dial(\"unix\", sockPath)\n\tif err != nil {\n\t\treturn\n\t}\n\tdefer conn.Close()\n\t_, _ = conn.Write([]byte(\"reload\\n\"))\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":120,"cache_read_input_tokens":29674,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":120},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"b7a4c6f5-9694-4de0-bf06-00f30709f32b","uuid":"3d41d67b-5a00-4ace-9878-32b7d94c69a2"}
