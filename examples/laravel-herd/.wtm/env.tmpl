# Attention: This is a stripped down version of the default Laravel .env file, just for the sake of the example.

APP_NAME=Laravel
APP_ENV=local
APP_URL=http://{{ .Branch | strings.Slug }}.myapp.test

DB_CONNECTION=mysql
DB_HOST={{ index .Vars "db_host" }}
DB_PORT={{ index .Vars "db_port" }}
DB_DATABASE=myapp_{{ .Branch | strings.SnakeCase }}
DB_USERNAME=root
DB_PASSWORD=
